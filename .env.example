# ---- Required ----
# Groq API key (https://console.groq.com/keys)
GROQ_API_KEY=

# Upstash Vector index credentials (https://console.upstash.com/vector)
# IMPORTANT: create the index WITH an embedding model selected so text is
# embedded server-side (no embeddings key needed on this app).
UPSTASH_VECTOR_REST_URL=
UPSTASH_VECTOR_REST_TOKEN=

# ---- Optional: distributed rate limiting (Upstash Redis) ----
# When both are set, /api/documents and /api/chat are rate-limited per IP.
# UPSTASH_REDIS_REST_URL=
# UPSTASH_REDIS_REST_TOKEN=

# ---- Optional overrides (defaults shown) ----
# GROQ_MODEL=llama3-70b-8192
# MAX_UPLOAD_BYTES=4000000
# TOP_K=4
